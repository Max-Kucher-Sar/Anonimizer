# Copy to .env for a local Linux check. Docker Compose reads this file.
ANON_ENV=development
ANON_API_KEY=
ANON_PORT=8000
ANON_API_WORKERS=1

# Same Ollama version as the verified Windows installation.
OLLAMA_IMAGE=ollama/ollama:0.40.0
ANON_OLLAMA_MODEL=qwen2.5:7b
# Per model request, not for the whole document. CPU may take much longer.
ANON_OLLAMA_TIMEOUT_SECONDS=600
ANON_OLLAMA_CHUNK_CHARS=2400

ANON_MAX_FILE_BYTES=20971520
ANON_MAX_OFFICE_SEGMENTS=20000
ANON_MAX_TEXT_CHARS=2000000

# Optional TLS profile: set your domain, production and a secret API key.
# ANON_ENV=production
# ANON_API_KEY=<your-secret>
ANON_DOMAIN=localhost
# Requests per minute per client IP. Replaces the old ANON_RATE_LIMIT=30r/m.
ANON_RATE_LIMIT_REQUESTS=30

